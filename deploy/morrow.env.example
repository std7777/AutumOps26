# Copy to /etc/morrow/morrow.env on the private app EC2. Never commit real values.
MORROW_DB_BACKEND=mysql
MORROW_DB_HOST=your-rds-endpoint.amazonaws.com
MORROW_DB_PORT=3306
MORROW_DB_NAME=morrow
MORROW_DB_USER=your_database_user
MORROW_DB_PASSWORD=replace_with_a_private_password
MORROW_HOST=0.0.0.0
MORROW_PORT=8080
MORROW_ADMIN_EMAIL=you@example.com
MORROW_ADMIN_PASSWORD=replace_with_a_long_private_password
# Change to 1 only when the public web server serves HTTPS.
MORROW_HTTPS=0
# Optional: path to the RDS CA bundle on the app EC2.
# MORROW_DB_SSL_CA=/etc/morrow/global-bundle.pem
